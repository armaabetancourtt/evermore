app "Contextual Inference"

function identity

  generic T
  takes value T
  returns T

  return value

end

function emptyNames

  returns list of text

  return identity([])

end

function countNames

  takes names list of text
  returns number

  return 0

end

function emptyCount

  returns number

  return countNames([])

end

function emptyMatrix

  returns list of list of number

  return [[]]

end

screen Home

  title "Inference where context is enough"

  text "Expected result types can flow backward through generic calls; ambiguous locals still fail."
