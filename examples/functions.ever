app "Core Language"

data User

  id id
  name text

end

function add

  takes a number
  takes b number
  returns number

  return a + b

end

function score

  takes base number
  returns number

  let doubled = base * 2
  return add(doubled, 10 / 2)

end

function identity

  takes user User
  returns User

  return user

end

function keepUsers

  takes users list of User
  returns list of User

  return users

end

function maybeUser

  takes user optional User
  returns optional User

  return user

end

function numbers

  returns list of number

  return [1, 2, 3]

end

function noUser

  returns optional User

  return none

end

function liftNumber

  takes value number
  returns optional number

  return value

end

function maybeNumbers

  returns list of optional number

  return [1, none, 3]

end

function classify

  takes score number
  returns text

  return if score >= 80 then "high" else "standard"

end

function maybeLabel

  takes enabled boolean
  returns optional text

  return if enabled == true then "ready" else none

end

function greeting

  returns text

  return "Hello from Evermore"

end

screen Home

  title "Domain logic belongs to Evermore"

  text "Functions are parsed, typed, lowered and generated."
